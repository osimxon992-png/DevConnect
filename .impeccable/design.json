  "narrative": {
    "northStar": "The Corridor Noticeboard",
    "overview": "DevConnect is the noticeboard outside a computer science department. The ground is a grey hallway wall. Posts are plain white sheets pinned to it, each lifted by a hairline paper shadow and nothing else. Projects, questions, jobs and groups are flyers on coloured copy paper, so a developer recognises the kind of thing before reading a word. The shell itself (sidebar, mobile bar, notices, modal heads) is solar yellow: the department's own board header.\n\nEverything is printed in photocopy ink. Type is one family, Archivo, ranked by width and weight: condensed, black, uppercase for things you read from across the corridor; normal width for things you read up close. Code is the only place JetBrains Mono appears, on black slabs like a terminal printout taped to the board. Corners are cut square everywhere. There are no gradients, no glows, no purple; the owner rejected those as \"obviously AI-made\", and the paper metaphor has no use for them.\n\nDensity is that of a busy board: dense but calm. Colour carries meaning (content type), ink carries structure (2px rules, reversed active states), and the paper does the rest.",
    "keyCharacteristics": [
      "Grey wall, white sheets, coloured flyers by content type, yellow shell.",
      "Ink #111 plus one pencil grey; no other text colours on paper.",
      "Archivo only, ranked by width (62 to 100) and weight; mono for code only.",
      "Zero radius on every surface and control.",
      "Hairline paper shadow; lift only on hover and for floating layers.",
      "Signature: perforated tear-off role tabs at the foot of project flyers.",
      "State as marks in fixed cells: hollow square open, filled square solved."
    ],
    "rules": [
      {
        "name": "The Copy Paper Rule",
        "body": "Each bright means one content type: pink is projects, blue is questions, green is jobs, orange is groups, yellow is the shell. Never use a bright decoratively or swap two of them.",
        "section": "colors"
      },
      {
        "name": "The No Gradient Rule",
        "body": "Every fill is flat. No gradients, no glows, no purple or violet anywhere. This is an owner commitment, not a preference.",
        "section": "colors"
      },
      {
        "name": "The Ink On Paper Rule",
        "body": "Text on any flyer stays photocopy ink (#111); muted text on a flyer darkens to #2b2b2b rather than going pencil grey.",
        "section": "colors"
      },
      {
        "name": "The Width Ranks Rule",
        "body": "Rank by width and weight, not by switching families. Narrower and heavier means louder. Never introduce a second display face.",
        "section": "typography"
      },
      {
        "name": "The Mono Is Code Rule",
        "body": "JetBrains Mono appears only where code appears. Labels, counts and meta stay in Archivo with tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Pinned Sheet Rule",
        "body": "At rest everything is a pinned sheet. Lift is a response to the pointer or a floating layer, never a resting decoration.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do colour a flyer by its content type only: projects pink, questions blue, jobs green, groups orange.",
      "Do keep the shell (sidebar, mobile bar, notices, modal heads) solar yellow.",
      "Do set text in photocopy ink (#111) or pencil grey (#55574f) and nothing else on paper.",
      "Do rank headings by Archivo width and weight: wdth 62 at 900 for the loudest, normal width for reading.",
      "Do use the sheet shadow at rest and the lifted shadow only on hover or floating layers.",
      "Do show state with square marks in fixed cells: hollow open, filled solved.",
      "Do reverse to ink for active navigation, tabs and selected chips."
    ],
    "donts": [
      "Don't use gradients, glows, or purple/violet anywhere.",
      "Don't round any corner; radius is 0 on every surface, control and mark.",
      "Don't give sheets borders; use the sheet shadow against the wall.",
      "Don't use a content-type bright for decoration or for a different content type.",
      "Don't set labels, counts or meta in JetBrains Mono; mono is for code.",
      "Don't use dashed lines anywhere except the tear-off perforation."
    ]
  }
}
